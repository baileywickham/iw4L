#!/bin/bash
# Kill any IW4L game process launched on this Mac (live runs belong on the Air via iw4l-air).
while true; do
  for pid in $(pgrep -x iw4l); do
    echo "$(date '+%H:%M:%S') killed local iw4l pid=$pid: $(ps -o command= -p $pid | cut -c1-160)" >> /tmp/iw4l-local-guard.log
    kill "$pid" 2>/dev/null
  done
  sleep 2
done
